{
  "name": "ai-browser",
  "version": "2.0.2",
  "description": "AI Browser",
  "type": "module",
  "license": "MIT",
  "author": "Jun Murakami",
  "homepage": "https://github.com/Jun-Murakami/AI-Browser",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check",
    "lint:fix": "biome check --write .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dev": "tauri dev",
    "devtools": "npx react-devtools",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build": "npm run typecheck && tauri build",
    "build:win": "pwsh -NoProfile -File build_windows_release.ps1",
    "build:mac": "zsh build_macos.zsh",
    "licenses": "license-checker --production --json --out src/renderer/src/assets/license.json",
    "tauri": "tauri"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/m-plus-1p": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@tanstack/react-hotkeys": "^0.17.0",
    "@tanstack/react-virtual": "^3.14.22",
    "@tauri-apps/api": "^2.12.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "allotment": "^1.20.6",
    "monaco-editor": "^0.57.0",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.8",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "license-checker": "^25.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.17"
    }
  }
}
