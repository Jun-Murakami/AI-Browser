{
  "name": "ai-browser",
  "version": "1.7.2",
  "description": "AI Browser",
  "type": "module",
  "main": "./out/main/index.js",
  "license": "MIT",
  "author": "Jun Murakami",
  "homepage": "https://github.com/Jun-Murakami/AI-Browser",
  "desktopName": "ai-browser.desktop",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check",
    "lint:fix": "biome check --write .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "devtools": "npx react-devtools",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "node scripts/fix-pty-module.cjs",
    "postinstall-disabled": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "license-checker --production --json --out src/renderer/src/assets/license.json && npm run build && node scripts/run-builder.cjs --win",
    "build:mac": "electron-vite build && node scripts/run-builder.cjs --mac",
    "build:linux": "license-checker --production --json --out src/renderer/src/assets/license.json && npm run build && node scripts/run-builder.cjs --linux",
    "build-appx": "electron-builder -w appx"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/m-plus-1p": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@tanstack/react-hotkeys": "^0.17.0",
    "@tanstack/react-virtual": "^3.14.22",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "allotment": "^1.20.6",
    "electron-context-menu": "^5.1.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.2.0-beta.15",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.8",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "license-checker": "^25.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.17"
    }
  }
}
